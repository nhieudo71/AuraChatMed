rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'theme', 'ttsVoice', 'encryptedApiKey', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('theme' in data) || (data.theme is string && data.theme.size() <= 20)) &&
        (!('ttsVoice' in data) || (data.ttsVoice is string && data.ttsVoice.size() <= 50)) &&
        (!('encryptedApiKey' in data) || (data.encryptedApiKey is string && data.encryptedApiKey.size() <= 500)) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'systemPrompt', 'model', 'thinkingLevel', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        (!('systemPrompt' in data) || (data.systemPrompt is string && data.systemPrompt.size() <= 5000)) &&
        (!('model' in data) || (data.model is string && data.model.size() <= 100)) &&
        (!('thinkingLevel' in data) || (data.thinkingLevel is string && data.thinkingLevel.size() <= 50)) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['sessionId', 'userId', 'role', 'content', 'createdAt']) &&
        data.keys().hasOnly(['sessionId', 'userId', 'role', 'content', 'thinkingContent', 'createdAt']) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        (data.role == 'user' || data.role == 'model' || data.role == 'system') &&
        data.content is string && data.content.size() <= 25000 &&
        (!('thinkingContent' in data) || (data.thinkingContent is string && data.thinkingContent.size() <= 25000)) &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // User preferences & profile
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Chat sessions
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) &&
        isValidChatSession(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(sessionId) && resource.data.userId == request.auth.uid &&
        isValidChatSession(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(sessionId) && resource.data.userId == request.auth.uid;

      // Messages in a session
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) && resource.data.userId == request.auth.uid;
        allow list: if isSignedIn() && isValidId(sessionId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().userId == request.auth.uid &&
          incoming().sessionId == sessionId &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) &&
          resource.data.userId == request.auth.uid &&
          isValidChatMessage(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().sessionId == existing().sessionId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) && resource.data.userId == request.auth.uid;
      }
    }
  }
}
