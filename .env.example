# ==========================================================================
# AuraChat AI — Cấu hình biến môi trường
# Sao chép tệp này thành `.env` rồi điền giá trị của bạn.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Khóa API Google Gemini (bắt buộc nếu không nhập khóa trên giao diện)
# --------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --------------------------------------------------------------------------
# 2. Cổng & địa chỉ máy chủ
# --------------------------------------------------------------------------
PORT="3000"
HOST="0.0.0.0"
APP_URL="http://localhost:3000"

# Bật/tắt Hot Module Replacement trong lúc phát triển.
# Đặt "false" khi chạy trong môi trường không hỗ trợ WebSocket (Docker, sandbox).
VITE_HMR="true"

# --------------------------------------------------------------------------
# 3. Tên mô hình AI
# Trước đây các giá trị này bị gắn cứng vào mã nguồn; nay đổi tại đây.
# --------------------------------------------------------------------------
VITE_FAST_MODEL="gemini-3.8-flash"
VITE_THINKING_MODEL="gemini-4-argon"
VITE_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
VITE_DEFAULT_TTS_MODEL="eleven_multilingual_v2"
VITE_DEFAULT_CUSTOM_LLM_MODEL="gpt-4o"

# User-Agent gửi kèm khi gọi Gemini API.
VITE_GEMINI_USER_AGENT="AuraChat/1.0"

# --------------------------------------------------------------------------
# 4. Firebase
# Bỏ trống để dùng giá trị trong `firebase-applet-config.json`
# (tệp do Google AI Studio sinh ra, gắn với sandbox của nền tảng).
# Muốn dùng Firebase project riêng thì điền đầy đủ các biến dưới đây.
# --------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# ID database Firestore. Để trống = database mặc định "(default)".
# AI Studio dùng database riêng dạng "ai-studio-<uuid>".
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
